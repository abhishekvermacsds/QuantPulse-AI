# ==============================================================================
# QuantPulse AI - Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local configuration:
#   cp .env.example .env
# Never commit real credentials or .env files to version control.
# ==============================================================================

# Application Environment (development | staging | production)
PORTFOLIO_ENV=development

# Database Settings (PostgreSQL 16)
# For local running without Docker, SQLite fallback is available: sqlite:///data/quantpulse.db
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/quantpulse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=quantpulse
POSTGRES_PORT=5432

# Redis Cache & Message Broker (Redis 7)
REDIS_URL=redis://localhost:6379/0

# Celery Asynchronous Worker
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Set to true for synchronous testing without running redis/celery daemon
CELERY_TASK_ALWAYS_EAGER=false

# FastAPI Backend Configuration
API_HOST=0.0.0.0
API_PORT=8000
CACHE_DEFAULT_TTL=300

# Frontend Configuration
VITE_API_URL=http://localhost:8000/api
